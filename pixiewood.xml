<?xml version="1.0" encoding="UTF-8"?>
<app xmlns="https://sp1rit.arpa/pixiewood/" xmlns:xi="http://www.w3.org/2001/XInclude">
  <metainfo vercalc="count">
    <xi:include href="build://{arch}/uk.nandi.sleek.metainfo.xml" parse="xml"/>
  </metainfo>
  <style>
    <theme name="adwaita"/>
    <icon type="generate">
      <drawable target="foreground" scale=".55" type="svg" path="src://assets/uk.nandi.sleek.svg"/>
      <color target="background">#241f31</color>
      <drawable target="monochrome" scale=".55" type="svg" path="src://assets/uk.nandi.sleek.svg"/>
    </icon>
  </style>
  <dependencies>
    <glib><patch>hack</patch></glib>
    <fontconfig/>
    <gtk/>
    <libadwaita/>
  </dependencies>
  <build target="sleek">
    <architectures>
      <arch>aarch64</arch>
      <arch>x86_64</arch>
    </architectures>
  </build>
</app>
