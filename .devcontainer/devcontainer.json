{
  "name": "sleek (nix-codespace)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "upgradePackages": false
    }
  },
  "forwardPorts": [],
  "postCreateCommand": "bash scripts/codespace-bootstrap.sh",
  "postStartCommand": "bash scripts/codespace-bootstrap.sh --quiet",
  "containerEnv": {
    "NIX_CONFIG": "experimental-features = nix-command flakes\nextra-experimental-features = nix-command flakes\naccept-flake-config = true",
    "CACHIX_CACHE": "codegod100"
  },
  "remoteEnv": {
    "SLEEK_CODESPACE": "1",
    "NIX_CONFIG": "experimental-features = nix-command flakes\nextra-experimental-features = nix-command flakes\naccept-flake-config = true",
    "CACHIX_CACHE": "codegod100"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.cwd": "${containerWorkspaceFolder}",
        "nix.enableLanguageServer": true
      },
      "extensions": [
        "jnoortheen.nix-ide",
        "rust-lang.rust-analyzer"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  }
}
