#!/usr/bin/env bash
set -euo pipefail

script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
repo_root=$(cd -- "$(dirname -- "${script_path}")" && pwd)

if [[ -f "${repo_root}/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "${repo_root}/.env"
  set +a
fi

# Keep this repository on a daemon started by this wrapper. A daemon launched
# earlier by a system `buck2` binary retains its original environment and
# therefore cannot expand credentials loaded from this repository's `.env`.
exec dotslash "${repo_root}/buck2.dotslash" --isolation-dir sleek-buildbuddy "$@"
