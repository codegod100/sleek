# pixi dev-shell env (pixi.toml) — reproduced from pixi.lock, not committed
.pixi/
# devenv's local nix-eval cache/state (devenv.nix) — same role as .direnv/
.devenv/
# flatpak-builder scratch state + bundle output (flatpak/uk.nandi.sleek.json
# is the only committed file in flatpak/)
/flatpak/build-dir/
/flatpak/export-repo/
/flatpak/.flatpak-builder/
/flatpak/*.flatpak
# Singularity/Apptainer image output of `nix build .#sif` (flake.nix's
# sleek-sif target) — 600MB+, a local build artifact, never committed.
/sleek.sif
/result-sif
