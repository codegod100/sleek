[cells]
    root = .
    prelude = prelude
    toolchains = toolchains
    none = none

[cell_aliases]
    config = prelude
    ovr_config = prelude
    fbcode = none
    fbsource = none
    buck = none

# Use the prelude bundled in the buck2 binary itself — no submodule to pin/update.
[external_cells]
    prelude = bundled

[parser]
    target_platform_detector_spec = target:root//...->prelude//platforms:default \
      target:toolchains//...->prelude//platforms:default

[buck2]
    digest_algorithms = SHA256

# BuildBuddy remote execution and cache, on by default (see
# platforms/defs.bzl for how `buildbuddy.enabled` gates both settings on the
# execution platform).
#
# `./buck2` loads BUILDBUDDY_API_KEY from the environment or an optional `.env`
# file. When it is absent, the wrapper disables this setting automatically
# because buck2 has no graceful "key missing, skip caching" fallback. Calls to
# a system `buck2` binary can opt out locally (git-ignored, not this file):
#   printf '[buildbuddy]\n    enabled = false\n' > .buckconfig.local
[buildbuddy]
    enabled = true

# engine/CAS/action-cache all live on BuildBuddy's single SaaS endpoint —
# only the API key (a secret) needs to come from the environment.
[buck2_re_client]
    engine_address = remote.buildbuddy.io:443
    action_cache_address = remote.buildbuddy.io:443
    cas_address = remote.buildbuddy.io:443
    http_headers = x-buildbuddy-api-key:$BUILDBUDDY_API_KEY

[build]
    execution_platforms = root//platforms:platforms
